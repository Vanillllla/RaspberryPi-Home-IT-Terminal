{
  "apiVersion": 1,
  "id": "input",
  "version": "1.0.0",
  "name": {
    "ru": "Поле ввода",
    "en": "Input"
  },
  "description": {
    "ru": "Принимает текст, число, IPv4, дату или время. Enter или уход из поля подтверждает ввод.",
    "en": "Accepts text, numbers, IPv4, dates or times. Press Enter or leave the field to commit."
  },
  "defaultFrame": {
    "x": 0,
    "y": 0,
    "w": 184,
    "h": 44
  },
  "properties": {
    "label": {
      "type": "string",
      "label": {
        "ru": "Подпись",
        "en": "Label"
      },
      "default": "Input",
      "localized": true
    },
    "value": {
      "type": "string",
      "label": {
        "ru": "Значение",
        "en": "Value"
      },
      "default": ""
    },
    "placeholder": {
      "type": "string",
      "label": {
        "ru": "Подсказка",
        "en": "Placeholder"
      },
      "default": "",
      "localized": true
    },
    "format": {
      "type": "choice",
      "label": {
        "ru": "Формат",
        "en": "Format"
      },
      "default": "text",
      "options": [
        "text",
        "number",
        "ipv4",
        "date",
        "time"
      ],
      "optionLabels": {
        "text": {
          "ru": "Текст",
          "en": "Text"
        },
        "number": {
          "ru": "Число",
          "en": "Number"
        },
        "ipv4": {
          "ru": "IPv4",
          "en": "IPv4"
        },
        "date": {
          "ru": "Дата",
          "en": "Date"
        },
        "time": {
          "ru": "Время",
          "en": "Time"
        }
      }
    },
    "enabled": {
      "type": "boolean",
      "label": {
        "ru": "Доступен",
        "en": "Enabled"
      },
      "default": true
    }
  },
  "events": {
    "onChange": {
      "description": {
        "ru": "Изменение значения",
        "en": "Value changed"
      },
      "writes": [
        "value"
      ]
    }
  },
  "strings": {
    "Input": {
      "ru": "Поле ввода",
      "en": "Input"
    }
  }
}
