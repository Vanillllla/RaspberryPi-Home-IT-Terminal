{
  "apiVersion": 1,
  "id": "shortcut",
  "version": "1.0.0",
  "name": {
    "ru": "Ярлык",
    "en": "Shortcut"
  },
  "description": {
    "ru": "Открывает HTTP- или HTTPS-ссылку. Можно указать иконку из assets или favicon сайта.",
    "en": "Opens an HTTP or HTTPS URL. Optionally use an asset icon or the site favicon."
  },
  "defaultFrame": {
    "x": 0,
    "y": 0,
    "w": 140,
    "h": 44
  },
  "properties": {
    "label": {
      "type": "string",
      "label": {
        "ru": "Подпись",
        "en": "Label"
      },
      "default": "Open",
      "localized": true
    },
    "url": {
      "type": "string",
      "label": {
        "ru": "Адрес",
        "en": "URL"
      },
      "default": "https://example.org"
    },
    "icon": {
      "type": "string",
      "label": {
        "ru": "Файл иконки",
        "en": "Icon asset"
      },
      "default": ""
    },
    "siteIcon": {
      "type": "boolean",
      "label": {
        "ru": "Иконка сайта",
        "en": "Site favicon"
      },
      "default": false
    }
  },
  "events": {
    "onClick": {
      "description": {
        "ru": "Нажатие",
        "en": "Activated"
      },
      "writes": []
    }
  },
  "strings": {
    "Open": {
      "ru": "Открыть",
      "en": "Open"
    }
  }
}
