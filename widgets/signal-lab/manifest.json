  "strings": {
    "Power": {
      "en": "Power",
      "ru": "Питание"
    },
    "Level": {
      "en": "Level",
      "ru": "Уровень"
    },
    "Apply": {
      "en": "Apply",
      "ru": "Применить"
    },
    "Ready": {
      "en": "Ready",
      "ru": "Готов"
    },
    "On": {
      "en": "On",
      "ru": "Включён"
    },
    "Off": {
      "en": "Off",
      "ru": "Выключен"
    }
