{
  "apiVersion": 1,
  "id": "signal-lab",
  "name": {
    "en": "Signal bench",
    "ru": "Проверка сигнала"
  },
  "description": {
    "en": "Read two controls and apply their values.",
    "ru": "Кнопка читает переключатель и слайдер и обновляет индикатор."
  },
  "version": "1.0.0",
  "author": "Pi Terminal",
  "width": 4,
  "height": 2,
