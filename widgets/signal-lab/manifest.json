  "views": {
    "widget": {
      "width": 720,
      "height": 480,
      "nodes": [
        {
          "id": "power",
          "type": "switch",
          "frame": {
            "x": 8,
            "y": 8,
            "w": 156,
            "h": 44
          },
          "props": {
            "label": "Power",
            "value": true
          },
          "events": {}
        },
        {
          "id": "level",
          "type": "slider",
          "frame": {
            "x": 172,
            "y": 8,
            "w": 192,
            "h": 44
          },
          "props": {
            "label": "Level",
            "value": 35
          },
          "events": {}
        },
        {
          "id": "apply",
          "type": "button",
          "frame": {
            "x": 8,
            "y": 68,
            "w": 140,
            "h": 48
          },
