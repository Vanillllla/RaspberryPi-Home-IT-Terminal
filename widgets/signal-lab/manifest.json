            "x": 172,
            "y": 74,
            "w": 180,
            "h": 40
          },
          "props": {
            "label": "Ready"
          },
          "events": {}
        },
        {
          "id": "result",
          "type": "text",
          "frame": {
            "x": 8,
            "y": 132,
            "w": 342,
            "h": 44
